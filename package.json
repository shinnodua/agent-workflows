{
	"name": "@shinnodua/agent-workflows",
	"version": "0.1.7",
	"description": "Installable multi-repository agent workflow template with local dashboard tooling.",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/shinnodua/agent-workflows.git"
	},
	"packageManager": "bun@1.3.14",
	"workspaces": [
		".",
		"dashboard"
	],
	"publishConfig": {
		"registry": "https://npm.pkg.github.com"
	},
	"bin": {
		"workflows": "./bin/workflows.js"
	},
	"files": [
		".agents",
		".codex",
		".claude",
		"AGENTS.md",
		"CLAUDE.md",
		"bin",
		"commands",
		"dashboard/.agents",
		"dashboard/AGENTS.md",
		"dashboard/bun.lock",
		"dashboard/index.html",
		"dashboard/package.json",
		"dashboard/src",
		"dashboard/tsconfig.json",
		"dashboard/vite.config.ts",
		"designs/.gitkeep",
		"docs",
		"meeting-logs/.gitkeep",
		"modules/.gitkeep",
		"plans/.gitkeep",
		"prds/.gitkeep",
		"project",
		"README.md",
		"research/.gitkeep",
		"roles",
		"scripts",
		"templates",
		"workflows.md",
		"workspace.config.json",
		".gitmodules.example"
	],
	"scripts": {
		"dashboard:build": "bun run --cwd dashboard build",
		"dashboard:dev": "bun run --cwd dashboard dev",
		"dashboard:lint": "bun run --cwd dashboard lint",
		"dashboard:lint:fix": "bun run --cwd dashboard lint:fix",
		"dashboard:test": "bun run --cwd dashboard test",
		"dashboard:typecheck": "bun run --cwd dashboard typecheck",
		"workspace:integrity": "bun run scripts/workspace-integrity.ts",
		"workspace:check": "bun run workspace:integrity && bun run lint && bun run dashboard:test && bun run dashboard:typecheck && bun run dashboard:build",
		"changeset": "changeset",
		"version": "changeset version",
		"release": "changeset publish",
		"package:dry-run": "npm pack --dry-run",
		"package:pack": "npm pack",
		"package:build": "bun run workspace:check && bun run package:dry-run",
		"git:pull": "git pull --recurse-submodules",
		"git:push": "git push --recurse-submodules=check",
		"git:push-all": "git push --recurse-submodules=on-demand",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"postinstall": "node ./bin/postinstall.js",
		"hooks:install": "lefthook install"
	},
	"dependencies": {
		"@biomejs/biome": "2.5.5",
		"@tailwindcss/vite": "4.3.3",
		"@vitejs/plugin-react": "4.7.0",
		"lucide-react": "1.26.0",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"tailwindcss": "4.3.3",
		"vite": "7.3.6"
	},
	"devDependencies": {
		"@changesets/cli": "3.0.1",
		"lefthook": "2.1.10"
	}
}
